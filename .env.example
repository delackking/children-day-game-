# PORT: HTTP + Socket.IO server port (default 3000 in AI Studio)
PORT=3000

# APP_URL: Public URL of the deployed application
APP_URL="http://localhost:3000"

# VITE_SERVER_URL: Optional backend origin (e.g. https://your-carnival-api.onrender.com)
# Leave empty when serving frontend + backend from the same Node server.
VITE_SERVER_URL=""

# DATABASE_URL: PostgreSQL connection string for production Prisma ORM deployment
# (Local development automatically uses zero-config persistent storage in ./data/carnival-rooms.json)
DATABASE_URL="postgresql://user:password@localhost:5432/carnival_db?schema=public"

# INITIAL_COINS: Starting virtual coins per player joining a room
INITIAL_COINS=500

# GEMINI_API_KEY: Optional server-side key (unused in core gameplay)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
